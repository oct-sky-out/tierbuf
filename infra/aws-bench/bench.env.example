# Copy this file to bench.env, then replace the required values.

# AWS region and EC2 instance type. i4i.large is sufficient for the default
# NVMe-only 8 GiB benchmark. Set i4i.2xlarge (64 GiB) or larger before enabling
# BENCH_S3_BUCKET because the S3 curve includes a 32 GiB DRAM fraction.
export REGION="ap-northeast-1"
export INSTANCE_TYPE="i4i.large"

# Result artifacts are uploaded to this bucket under results/<run-id>/.
# S3 bucket names are globally unique.
export BUCKET="replace-with-a-globally-unique-bucket-name"

# Optional S3-backed degradation demo. Leave BENCH_S3_BUCKET empty to run only
# the existing NVMe curve. This data bucket must differ from BUCKET; objects
# under tierbuf-bench/ expire after one day when setup-once.sh configures it.
export BENCH_S3_BUCKET=""
export BENCH_S3_REGION="${REGION}"

# Optional FileTier compression crossover sweep. Set to 1 to measure where LZ4
# slot compression starts beating the io_uring raw-slot path on this instance's
# NVMe. It runs 2 x BENCH_FILE_COMPRESSION_PCTS benchmarks against the local
# NVMe only, so it adds no S3 charges. Budget roughly
# (warmup + measure) x 2 x <number of percentages> seconds plus warmup overhead.
export BENCH_FILE_COMPRESSION_DEMO=""
export BENCH_FILE_COMPRESSION_PCTS="0,25,50,75,90,100"
export BENCH_FILE_COMPRESSION_DATASET_MIB="8192"
export BENCH_FILE_COMPRESSION_FRACTION="0.25"

# The instance clones this public HTTPS repository.
export REPO_URL="https://github.com/YOUR_GITHUB_ID/tierbuf.git"
export REPO_BRANCH="main"

# Arguments supported by the current tierbuf-bench CLI. The DRAM fractions are
# fixed by the harness at 1.0, 0.8, 0.6, 0.4, 0.2, and 0.1.
export BENCH_ARGS="--dataset-mib 8192 --warmup-secs 10 --measure-secs 30 --workers 4"

# Hard billing guard. Use at least 180 when BENCH_S3_BUCKET is enabled; the
# launcher validates both this value and 64 GiB of instance memory.
export MAX_MINUTES="180"

# Optional SSH debugging. Leave both empty for the recommended SSH-free setup.
export KEY_NAME=""
export SSH_CIDR=""

# Resource names created by setup-once.sh.
export ROLE_NAME="tierbuf-bench-role"
export PROFILE_NAME="tierbuf-bench-profile"
export SG_NAME="tierbuf-bench-sg"
